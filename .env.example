# MySQL Database Configuration
DB_URL=jdbc:mysql://mysql:3306/resqtrace?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=secret_db_password

# JWT Authentication
JWT_SECRET=a_very_long_secure_random_string_for_production_jwt_signing_which_should_be_at_least_256_bits
JWT_EXPIRATION=86400000

# Server / CORS Configuration
SERVER_PORT=8080
RESQTRACE_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://your-production-domain.com

# Storage Configuration (local or s3)
RESQTRACE_STORAGE_PROVIDER=local
# RESQTRACE_STORAGE_S3_BUCKET=your-bucket-name
# RESQTRACE_STORAGE_S3_REGION=us-east-1

# AI Service Configuration
AI_SERVICE_URL=http://ai-service:8000
